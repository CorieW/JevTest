{
  "name": "jevtest",
  "homepage": "https://jevtest.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CorieW/JevTest.git"
  },
  "bugs": {
    "url": "https://github.com/CorieW/JevTest/issues"
  },
  "version": "0.1.0",
  "private": true,
  "description": "Bounded exploratory browser testing with Jev and reproducible evidence.",
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "jevtest": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p config/tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "demo": "tsx examples/shop/run.ts",
    "demo:live": "tsx --env-file=.env.local examples/shop/run.ts --live",
    "browser:install": "playwright install chromium",
    "test": "vitest run --config config/vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --config config/eslint.config.js --max-warnings 0",
    "format": "prettier --write . --config config/prettier.json",
    "format:check": "prettier --check . --config config/prettier.json",
    "secrets:check": "node scripts/check-secrets.mjs",
    "verify": "pnpm secrets:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "playwright": "1.62.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.10.12",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "prettier": "^3.8.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.11"
  }
}
