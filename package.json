{
  "name": "jevtest",
  "homepage": "https://jevtest.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CorieW/JevTest.git"
  },
  "bugs": {
    "url": "https://github.com/CorieW/JevTest/issues"
  },
  "version": "0.1.0",
  "private": true,
  "description": "Bounded exploratory browser testing with Jev and reproducible evidence.",
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "jevtest": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm build:core && pnpm web-viewer:build",
    "dev": "tsx src/cli.ts",
    "demo": "tsx examples/shop/jevtest/run.ts",
    "demo:live": "tsx examples/shop/jevtest/run.ts --live --env-file .env.local",
    "benchmark": "tsx test/benchmarks/evaluate.ts",
    "benchmark:serve": "tsx test/benchmarks/serve.ts",
    "browser:install": "playwright install chromium",
    "test": "pnpm test:core && pnpm web-viewer:test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web-viewer/tsconfig.json",
    "lint": "eslint . --config config/eslint.config.js --max-warnings 0",
    "format": "prettier --write . --config config/prettier.json",
    "format:check": "prettier --check . --config config/prettier.json",
    "secrets:check": "node scripts/check-secrets.mjs",
    "verify": "pnpm secrets:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "setup:local": "tsx src/cli.ts setup",
    "build:core": "tsc -p config/tsconfig.build.json",
    "web-viewer:build": "node web-viewer/build.mjs",
    "web-viewer:serve": "pnpm web-viewer:build && tsx web-viewer/cli.ts",
    "web-viewer:test": "pnpm web-viewer:build && vitest run --config web-viewer/vitest.config.ts",
    "test:core": "vitest run --config config/vitest.config.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@xyflow/react": "^12.11.6",
    "playwright": "1.62.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.10.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "prettier": "^3.8.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^5.0.1"
  }
}
